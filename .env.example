# ---- Postgres (consumed by the postgres container) ----
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview_platform

# ---- Keycloak admin (consumed by the keycloak container) ----
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN=change-me

# ---- Keycloak issuer (consumed by api-gateway + interview-service) ----
APP_KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/{realm_name}
APP_KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/interview-platform/protocol/openid-connect/certs

# ---- api-gateway CORS (comma-separated allowed origins) ----
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- Frontend build (consumed at Vite build time inside the frontend image) ----
VITE_GATEWAY_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180

# ---- api-gateway -> interview-service route target (Docker DNS) ----
APP_INTERVIEW_SERVICE_URI=http://interview-service:8081

# ---- api-gateway -> interview-service route target (Docker DNS) ----
APP_INTERVIEW_SERVICE_URI=http://{service_name}:{port}

# ---- Postgres datasource (consumed by interview-service) ----
APP_DATASOURCE_URL=jdbc:postgresql://postgres:5432/interview_platform
APP_DATASOURCE_USERNAME=interview
APP_DATASOURCE_PASSWORD=change-me

# ---- Postgres datasource (consumed by notification-service; same db/container, notification schema) ----
APP_NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://postgres:5432/interview_platform
APP_NOTIFICATION_DATASOURCE_USERNAME=interview
APP_NOTIFICATION_DATASOURCE_PASSWORD=change-me

# ---- Mail (consumed by notification-service -> MailHog) ----
APP_MAIL_HOST=mailhog
APP_MAIL_FROM=no-reply@interview-platform.local

# ---- ZEGO video credentials (consumed by interview-service for video tokens) ----
# ZEGO_APP_ID is non-secret and may reach the browser.
# ZEGO_SERVER_SECRET is secret: never log it, never return it in a response, and
# never reference it from any frontend file. Fill in values locally; leave empty here.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=